---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'О НАС',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: '~/assets/images/rapsf.jpg',
      alt: 'content5',
    }}
  >

    <Fragment slot="subtitle">
<p>
Наше крестьянско-фермерское хозяйство — современное предприятие, специализирующееся на бережной переработке рапса, сохраняющей природные свойства семян, и производстве высококачественного растительного масла и жмыха. Мы объединяем аграрный опыт, современное оборудование и внимательное отношение к каждому этапу производства, чтобы создавать продукцию, которой можно доверять.
</p>

<p>
Наша цель — обеспечивать клиентов натуральной и надежной продукцией, развивая местное сельское хозяйство и поддерживая традиции ответственного земледелия. Мы открыты к сотрудничеству и всегда готовы предложить выгодные условия для фермеров, переработчиков и представителей пищевой и кормовой промышленности.
</p>
    </Fragment>

  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Цифры о нас"
    stats={[
      { title: 'Тонн масла в год', amount: '1320' },
      { title: 'Тонн жмыха в год', amount: '1820' },
      { title: 'Работников', amount: '6' },
    ]}
  />

</Layout>
