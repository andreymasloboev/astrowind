---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <ContactUs
    id="form"
    title="Оставьте нам сообщение!"
    subtitle="Если Вы не смогли связаться с нами, оставьте нам сообщение."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    description="Наша команда ответит Вам как можно скорее"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Мы ответим на все Ваши вопросы удобным Вам способом!"
    items={[
      {
        title: 'Телефон',
        description: '+7 (916) 243-16-26',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'andreymasloboev@yandex.ru',
        icon: 'tabler:mail',
      },
      {
        title: 'Местонахождение',
        description: 'Калужская область',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
