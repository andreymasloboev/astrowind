---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'SaaS Landing Page',
};
---

<Layout metadata={metadata}>

  <!-- Content Widget **************** -->

  <Content
    title="Рапсовый жмых"
    subtitle="Рапсовый жмых — это ценный высокопротеиновый продукт, получаемый после холодного отжима масла из семян рапса. Он широко используется в животноводстве как полноценный компонент комбикормов, обеспечивая животных легкоусвояемыми белками, аминокислотами и энергией. Жмых отличается стабильным качеством и является востребованным продуктом в фермерских хозяйствах и на кормовых предприятиях."
    isReversed
    items={[
      {
        title: 'Высокое содержание протеина'
      },
      {
        title: 'Богат аминокислотами'
      },
      {
        title: 'Высокая энергетическая ценность'
      },
      {
        title: 'Стабильное качество и безопасность'
      },
      {
        title: 'Экономически выгодный компонент кормов'
      },
    ]}
    image={{
      src: '~/assets/images/gmuh.jpg',
      alt: 'gmuh',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>
