---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'SaaS Landing Page',
};
---

<Layout metadata={metadata}>

  <!-- Content Widget **************** -->

  <Content
    title="Рапсовое масло"
    subtitle="Рапсовое масло холодного отжима — это натуральный продукт, полученный без термической обработки, благодаря чему сохраняются его природный вкус и максимальная пищевая ценность. Масло обладает мягким ароматом, высоким содержанием полезных жирных кислот и является востребованным как в кулинарии, так и в пищевой промышленности"
    isReversed
    items={[
      {
        title: 'Максимум полезных веществ'
      },
      {
        title: 'Оптимальный баланс жирных кислот'
      },
      {
        title: 'Низкое содержание насыщенных жиров'
      },
      {
        title: 'Натуральность и экологичность'
      },
      {
        title: 'Высокая ценность для кормовой промышленности'
      },
    ]}
    image={{
      src: '~/assets/images/oilrazliv.jpg',
      alt: 'oilrazliv.jpg',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>
