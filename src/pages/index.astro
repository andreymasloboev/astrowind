---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'КФХ Андреевский',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

<section
  class="relative h-screen bg-cover bg-center"
  style="background-image: url('/images/ag_web_hero.jpg');"
>

  <!-- Основной контент -->
  <Hero>
    <div class="relative z-10 text-center text-white flex flex-col items-center justify-center h-full">
      <h1 class="text-5xl font-bold mb-4">Мой Hero во весь экран</h1>
      <p class="text-lg opacity-90">С фоном через внешний контейнер</p>
    </div>
  </Hero>
</section>



  <!-- Content Widget **************** -->

  <Content
    isReversed
    title="Мы производим"
    image={{
      src: '~/assets/images/content5.jpg',
      alt: 'content5',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Растительные масла</h3>
      Мы производит натуральные растительные масла холодного отжима — только семена, солнце и забота о качестве.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    image={{
      src: '~/assets/images/content3.jpg',
      alt: 'content3',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">И корма для Ваших питомцев</h3>
      Корма нашего производства — результат современных технологий и опыта, позволяющий достичь максимальных результатов в животноводстве.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>
