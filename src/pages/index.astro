---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'КФХ Андреевский',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

<section
  class="relative h-screen bg-cover bg-center"
  style="background-image: url('/src/assets/images/ag_web_hero.jpg');"
>

  <!-- ТЕКСТ СВЕРХУ -->
  <div class="absolute top-32 left-0 w-full text-center text-идфсл py-6 z-20">
    <h2 class="text-6xl font-semibold tracking-wide">Мы производим</h2>
  </div>

  <!-- Основной контент -->
  <Hero>
    <div class="relative z-10 text-center text-white flex flex-col items-center justify-center h-full">
      <h1 class="text-5xl font-bold mb-4">Мой Hero во весь экран</h1>
      <p class="text-lg opacity-90">С фоном через внешний контейнер</p>
    </div>
  </Hero>
</section>



  <!-- Content Widget **************** -->

  <Content
    isReversed
    image={{
      src: '~/assets/images/content1.jpg',
      alt: 'content1',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Агрокультуры</h3>
      Выращиваем агрокультуры с заботой о земле и будущем: пшеница, кукуруза, подсолнечник — натурально и экологично.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    image={{
      src: '~/assets/images/content2.jpg',
      alt: 'content2',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Качественные продукты для Вас</h3>
      Собственное производство и первичная переработка агрокультур позволяют нам гарантировать высокое качество и чистоту продукции.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    image={{
      src: '~/assets/images/content3.jpg',
      alt: 'content3',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">И корма для Ваших питомцев</h3>
      Корма нашего производства — результат современных технологий и опыта, позволяющий достичь максимальных результатов в животноводстве.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>
